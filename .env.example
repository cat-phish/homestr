# Copy to .env before running `docker compose up`. Never commit .env.
#
# This file is the template; your .env is yours alone and is git-ignored. Every
# value below has a working default in docker-compose.yml, so you only need to
# change the ones your machine forces you to.

# --- Per-developer isolation ---------------------------------------------
# Namespaces the containers, volumes and network. Change it to run two
# checkouts, two branches or two developers side by side on one host without
# them fighting over names or sharing a database.
# COMPOSE_PROJECT_NAME=homestr

# --- Platform ------------------------------------------------------------
# Bind-mount option suffix, appended to every host mount. It is a comma option
# because each mount already declares :rw or :ro, so write ",z" and not ":z".
#   Linux with SELinux (Fedora, RHEL, CentOS): ,z
#   macOS, Windows, Linux without SELinux:     leave empty
# Without it, SELinux hosts fail with "permission denied" reading the mounted
# sources. Note that `z` relabels the host directory persistently.
VOLUME_SUFFIX=

# --- Published host ports ------------------------------------------------
# Only the host side. The ports inside the containers are fixed, so the
# frontend proxy and nginx can always reach backend:8080.
# Change any of these that collide with something already running.
DB_PUBLISHED_PORT=3306
HOMESTR_PUBLISHED_PORT=8080
FRONTEND_PUBLISHED_PORT=5173

# --- MariaDB -------------------------------------------------------------
# Development placeholders. Rotate before anything is reachable off-host.
MARIADB_ROOT_PASSWORD=change_me_root
MARIADB_DATABASE=homestr_db
MARIADB_USER=homestr_user
MARIADB_PASSWORD=change_me_app
DB_HOST=db
DB_PORT=3306

# --- Backend -------------------------------------------------------------
HOMESTR_LOG_LEVEL=debug
HOMESTR_BUILD_TYPE=Debug
# Set to 1 to run the GoogleTest suites on container start, before the server.
HOMESTR_RUN_TESTS=0
# HS256 secret for session tokens, once auth lands (ROADMAP.md step 1).
# Generate with: openssl rand -hex 32
HOMESTR_JWT_SECRET=change_me_to_a_32_byte_hex_string

# --- Frontend (Vite; only VITE_* reach the browser bundle) ---------------
# Unset in the Docker setup: requests go through the Vite dev proxy, so the
# browser needs no absolute backend origin. Set these only when serving the
# WebUI separately from the hub.
# VITE_API_BASE_URL=http://localhost:8080/api/v1
# VITE_WS_URL=ws://localhost:8080/api/v1/ws
